{
    "name": "huntapi/sdk",
    "description": "Official PHP SDK for the HuntAPI media download API.",
    "type": "library",
    "keywords": [
        "api",
        "async-api",
        "audio-download-api",
        "huntapi",
        "media-metadata",
        "sdk",
        "video-download-api"
    ],
    "homepage": "https://www.huntapi.com",
    "license": "MIT",
    "authors": [
        {
            "name": "HuntAPI",
            "email": "contact@huntapi.com"
        }
    ],
    "support": {
        "issues": "https://github.com/huntapi/huntapi-php/issues",
        "source": "https://github.com/huntapi/huntapi-php",
        "docs": "https://docs.huntapi.com"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "HuntApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HuntApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "test": "phpunit --configuration=phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
